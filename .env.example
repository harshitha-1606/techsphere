# Copy to .env and edit. Never commit .env.
SECRET_KEY=change-me-to-a-long-random-string
DEMO_MODE=true
COORDINATOR_USERNAME=techshere
# Generate with: python -c "from werkzeug.security import generate_password_hash as g; print(g('your-password'))"
COORDINATOR_PASSWORD_HASH=
DATA_DIR=./data
COOKIE_SECURE=false
# Comma-separated origins allowed when the frontend is hosted separately (leave empty if served by Flask)
CORS_ORIGINS=
